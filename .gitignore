# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# publisher runtime state: publication reports, the .publish.lock, and the
# scheduler's own stdout/stderr log. The publisher refuses to run from a dirty
# worktree, so anything written here has to be ignored or a run's own log file
# makes the NEXT run refuse to start.
runtime/

# environment variables
.env
.env.production

# macOS
.DS_Store

# editors
.idea/
.vscode/*
!.vscode/extensions.json

# AI assistant config (kept local, not part of the publication contract)
CLAUDE.md

# astro content-layer probe outputs (tests/refine-probe)
tests/refine-probe/dist/
tests/refine-probe/.astro/
tests/refine-probe/node_modules/
