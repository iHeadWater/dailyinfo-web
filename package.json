{
  "name": "dailyinfo-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DailyInfo public web portal — static publication site built with Astro.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --force && npm run verify-build",
    "verify-build": "node scripts/verify-build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "node scripts/validate-content.mjs",
    "test": "node scripts/contract-tests.mjs && node scripts/dailyinfo-sync.tests.mjs && node scripts/dailyinfo-publish.tests.mjs",
    "dailyinfo:sync": "node scripts/dailyinfo-sync.mjs",
    "dailyinfo:publish": "node scripts/dailyinfo-publish.mjs",
    "dailyinfo:fallback": "node scripts/dailyinfo-fallback.mjs",
    "ci": "npm run validate && npm run test && npm run check && npm run build"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@astrojs/markdown-remark": "6.3.11",
    "rehype-sanitize": "^6.0.0",
    "typescript": "^5.5.0",
    "yaml": "^2.4.0"
  }
}
