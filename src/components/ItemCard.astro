---
import { CATEGORY_BY_ID } from '../lib/categories.ts';
import { itemRoute } from '../lib/urls.ts';
import { withBase } from '../lib/site.ts';
import { formatDisplayText, truncate } from '../lib/format.ts';
import type { ItemEntry } from '../lib/content.ts';
import TagList from './TagList.astro';
import ItemMeta from './ItemMeta.astro';

interface Props {
  item: ItemEntry;
  /** Show the category badge (default true on mixed-category lists). */
  showCategory?: boolean;
  /** Compact rows are used for large briefing and overview lists. */
  compact?: boolean;
  /** Show a useful category-specific technical identifier in research indexes. */
  showTechnicalId?: boolean;
  /** Match the card title to the page's semantic heading structure. */
  headingLevel?: 3 | 4;
}
const {
  item,
  showCategory = true,
  compact = false,
  showTechnicalId = false,
  headingLevel = 3,
} = Astro.props;

const category = CATEGORY_BY_ID[item.data.category];
const href = withBase(itemRoute(item.data.category, item.data.id));
const Heading = headingLevel === 4 ? 'h4' : 'h3';
const displayTitle = formatDisplayText(item.data.title);
const displaySummary = formatDisplayText(item.data.summary);
---

<article class:list={['item-card', { 'item-card--compact': compact }]} data-category={category.id}>
  <ItemMeta item={item} showCategory={showCategory} showExternalId={showTechnicalId} />
  <Heading class="item-card__title">
    <a href={href}>{displayTitle}</a>
  </Heading>
  <p class="item-card__summary">{truncate(displaySummary, compact ? 170 : 240)}</p>
  {item.data.tags.length > 0 && <TagList tags={item.data.tags} limit={compact ? 4 : 6} />}
</article>
