---
import { CATEGORIES } from '../lib/categories.ts';
import { categoryRoute, archiveRoute } from '../lib/urls.ts';
import { withBase } from '../lib/site.ts';

interface Props {
  /** Highlight the category matching this logical route (e.g. '/papers/'). */
  currentPath?: string;
}
const { currentPath } = Astro.props;

function isCategoryActive(slug: string): boolean {
  if (!currentPath) return false;
  return (
    currentPath === `/${slug}/` ||
    currentPath.startsWith(`/${slug}/`) ||
    new RegExp(`^/daily/[^/]+/${slug}/$`).test(currentPath)
  );
}
---

<nav class="category-nav" aria-label="分类导航">
  <a href={withBase('/')} aria-current={currentPath === '/' ? 'page' : undefined}>Home</a>
  {CATEGORIES.map((category) => (
    <a
      href={withBase(categoryRoute(category.id))}
      aria-current={isCategoryActive(category.slug) ? 'page' : undefined}
    >
      {category.label}
    </a>
  ))}
  <a
    href={withBase(archiveRoute())}
    aria-current={currentPath === archiveRoute() ? 'page' : undefined}
  >
    Archive
  </a>
</nav>
