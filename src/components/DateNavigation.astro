---
import { dailyRoute } from '../lib/urls.ts';
import { withBase } from '../lib/site.ts';
import { formatEditorialDate } from '../lib/format.ts';

interface Props {
  dates: string[];
  current?: string;
}
const { dates, current } = Astro.props;

if (dates.length === 0) return;

const currentIndex = current ? dates.indexOf(current) : -1;
const newer = currentIndex >= 0 ? dates[currentIndex - 1] : undefined;
const older = currentIndex >= 0 ? dates[currentIndex + 1] : undefined;
---

<nav class="date-navigation" aria-label="日期导航">
  <span class="date-navigation__links">
    {newer ? (
      <a href={withBase(dailyRoute(newer))}><span aria-hidden="true">←</span> {formatEditorialDate(newer)}</a>
    ) : (
      <span class="date-navigation__disabled"><span aria-hidden="true">←</span> 更新</span>
    )}
    {older ? (
      <a href={withBase(dailyRoute(older))}>{formatEditorialDate(older)} <span aria-hidden="true">→</span></a>
    ) : (
      <span class="date-navigation__disabled">更早 <span aria-hidden="true">→</span></span>
    )}
  </span>
</nav>
