---
import { SITE, withBase } from '../lib/site.ts';
import { buildSeo, type SeoInput } from '../lib/seo.ts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props extends SeoInput {
  /** Root-relative path of the current page, e.g. '/papers/'. */
  path: string;
}

const { path, ...seoInput } = Astro.props;
const seo = buildSeo({ path, ...seoInput });
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.name}
      href={withBase('/feed.xml')}
    />
    <meta property="og:title" content={seo.ogTitle} />
    <meta property="og:description" content={seo.ogDescription} />
    <meta property="og:url" content={seo.ogUrl} />
    <meta property="og:type" content={seo.ogType} />
    <meta property="og:site_name" content={SITE.name} />
    {seo.ogImage && <meta property="og:image" content={seo.ogImage} />}
    {seo.publishedTime && <meta property="article:published_time" content={seo.publishedTime} />}
    {seo.modifiedTime && <meta property="article:modified_time" content={seo.modifiedTime} />}
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Anti-flash bootstrap: must run before first paint (hence <head>).
      // Priority: explicit user choice (localStorage) > system preference.
      (function () {
        try {
          var stored = localStorage.getItem('dailyinfo-theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme =
            stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳至正文</a>
    <Header currentPath={path} />
    <main id="main-content" tabindex="-1">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
