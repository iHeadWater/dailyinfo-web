---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/site.ts';

const seo = {
  title: 'Page Not Found',
  description: '页面不存在。请从首页或 Archive 继续浏览 DailyInfo。',
  path: '/404/',
};
---

<BaseLayout {...seo}>
  <div class="reading-page">
    <p class="eyebrow">Error 404</p>
    <h1>404 · Page Not Found</h1>
    <p>该页面不存在。你可以：</p>
    <ul>
      <li><a href={withBase('/')}>返回首页</a>，查看最新日报；</li>
      <li><a href={withBase('/archive/')}>浏览 Archive</a>，按日期查找历史内容。</li>
    </ul>
  </div>
</BaseLayout>
