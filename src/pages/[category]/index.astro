---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryListing from '../../components/CategoryListing.astro';
import { CATEGORIES } from '../../lib/categories.ts';
import { categoryRoute, categoryPageRoute } from '../../lib/urls.ts';
import { loadSiteContent } from '../../lib/content.ts';
import { CATEGORY_PAGE_SIZE, paginate } from '../../lib/listing.ts';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { categoryId: category.id },
  }));
}

const { categoryId } = Astro.props;
const category = CATEGORIES.find((c) => c.id === categoryId)!;
const site = await loadSiteContent();
const items = site.itemsByCategory[category.id];
const window = paginate(items, 1, CATEGORY_PAGE_SIZE);
---

<BaseLayout
  title={category.label}
  description={`${category.label} — ${category.description}`}
  path={categoryRoute(category.id)}
  nextPath={window.totalPages > 1 ? categoryPageRoute(category.id, 2) : undefined}
>
  <CategoryListing category={category} items={items} page={1} />
</BaseLayout>
