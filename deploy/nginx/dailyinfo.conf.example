# DailyInfo static-site template for daily.iheadwater.org.
# Do not enable the 443 server until DNS resolves to this host and the
# referenced Let's Encrypt certificate files exist.

server {
    listen 80;
    listen [::]:80;
    server_name daily.iheadwater.org;

    # Certbot/another ACME client may write challenges here.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        auth_basic off;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name daily.iheadwater.org;

    root /var/www/dailyinfo/current;
    index index.html;
    autoindex off;

    # Placeholders: these files exist only after certificate issuance.
    ssl_certificate /etc/letsencrypt/live/daily.iheadwater.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/daily.iheadwater.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    auth_basic "DailyInfo";
    auth_basic_user_file /etc/nginx/.htpasswd-dailyinfo;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;

    # Astro fingerprints these assets, so they may be cached for one year.
    location ^~ /_astro/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # HTML and feeds should revalidate so daily publications appear promptly.
    location / {
        try_files $uri $uri/ $uri/index.html =404;
        add_header Cache-Control "no-cache";
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
        add_header Cache-Control "no-cache";
    }
}
